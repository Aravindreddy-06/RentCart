// Prisma schema for RentCart
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RentalStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  RETURNED
  CANCELLED
}

enum NotificationType {
  RENTAL_REQUESTED
  RENTAL_APPROVED
  RENTAL_REJECTED
  RENTAL_CANCELLED
  RENTAL_ACTIVATED
  RENTAL_RETURNED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  address      String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  items         Item[]         @relation("OwnerItems")
  rentals       Rental[]       @relation("BorrowerRentals")
  notifications Notification[]
  pushTokens    PushToken[]

  @@map("users")
}

model Item {
  id          String   @id @default(uuid())
  ownerId     String
  title       String
  description String
  category    String
  images      String[] // Array of image URLs
  pricePerDay Float
  deposit     Float    @default(0)
  isAvailable Boolean  @default(true)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner   User     @relation("OwnerItems", fields: [ownerId], references: [id], onDelete: Cascade)
  rentals Rental[]

  @@index([latitude, longitude])
  @@map("items")
}

model Rental {
  id            String       @id @default(uuid())
  itemId        String
  borrowerId    String
  startDate     DateTime     @db.Date
  endDate       DateTime     @db.Date
  totalPrice    Float
  depositAmount Float        @default(0)
  borrowerNote  String?
  ownerNote     String?
  status        RentalStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  item     Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrower User @relation("BorrowerRentals", fields: [borrowerId], references: [id], onDelete: Cascade)

  @@map("rentals")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}
