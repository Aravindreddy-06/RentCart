# Database & Server
DATABASE_URL="postgresql://user:password@localhost:5432/rentcart?schema=public"
PORT=4000
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key"
CLIENT_ORIGINS="http://localhost:5173,http://localhost:19006"
PUBLIC_BASE_URL="http://localhost:4000"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Handover & Return PIN Security
HANDOVER_PIN_SECRET="your-32-byte-hex-secret-here"
HANDOVER_PIN_ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
REQUIRE_RETURN_PIN=false

# Email Provider Configuration: "brevo" (HTTPS API, recommended on Render) or "smtp" (Nodemailer)
# Defaults to "smtp" in development; must be set explicitly in production.
MAIL_PROVIDER=brevo

# Brevo HTTPS API (Used when MAIL_PROVIDER=brevo)
BREVO_API_KEY=xkeysib-your-brevo-api-key
MAIL_FROM_EMAIL=your-verified-sender@example.com
MAIL_FROM_NAME="RentCart"

# SMTP (Used when MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RentCart <noreply@rentcart.app>"