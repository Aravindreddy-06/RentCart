{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rentcart-api.onrender.com/api",
        "GOOGLE_MAPS_API_KEY": "GOOGLE_MAPS_API_KEY"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rentcart-api.onrender.com/api",
        "GOOGLE_MAPS_API_KEY": "GOOGLE_MAPS_API_KEY"
      }
    }
  }
}